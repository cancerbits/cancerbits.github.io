---
import Icon from './Icon.astro';
import { site, nav } from '../data/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-ink-100 bg-white/90 backdrop-blur bg-dot-grid">
  <div class="mx-auto flex max-w-content items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/images/logo.png" alt="" class="h-10 w-10 shrink-0" />
      <span class="leading-tight">
        <span class="block text-base font-semibold text-ink-900 sm:text-lg">{site.title}</span>
        <span class="block text-xs text-ink-500 sm:text-sm">{site.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium no-underline transition nav-link',
            isActive(item.href)
              ? 'bg-brand-50 text-brand-700'
              : 'text-ink-600 hover:bg-ink-50 hover:text-ink-900',
          ]}
        >
          {item.icon === 'home' ? <Icon name="home" class="h-4 w-4" /> : item.label}
        </a>
      ))}
    </nav>

    <details class="relative md:hidden">
      <summary class="flex list-none items-center rounded-md p-2 text-ink-600 hover:bg-ink-50">
        <Icon name="menu" class="h-6 w-6" />
      </summary>
      <nav class="absolute right-0 top-full mt-2 w-56 rounded-lg border border-ink-100 bg-white p-2 shadow-lg">
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'block rounded-md px-3 py-2 text-sm font-medium no-underline nav-link',
              isActive(item.href) ? 'bg-brand-50 text-brand-700' : 'text-ink-700 hover:bg-ink-50',
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
