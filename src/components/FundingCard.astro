---
import type { CollectionEntry } from 'astro:content';

interface Props {
  funding: CollectionEntry<'funding'>['data'];
}
const { funding } = Astro.props;
---

<div class="flex flex-col rounded-xl border border-ink-100 bg-white p-6 shadow-sm card-hover">
  <div class="flex h-16 items-center">
    <img src={funding.logo} alt={funding.funder} class="max-h-14 max-w-[180px] object-contain" loading="lazy" />
  </div>
  <h3 class="mt-4 text-lg font-semibold text-ink-900">{funding.funder}</h3>
  <p class="mt-2 flex-1 text-sm text-ink-600">{funding.description}</p>
  {funding.links.length > 0 && (
    <p class="mt-3 text-sm">
      {funding.links.map((l, i) => (
        <>
          <a href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>
          {i < funding.links.length - 1 ? ', ' : ''}
        </>
      ))}
    </p>
  )}
</div>
