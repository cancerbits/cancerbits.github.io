---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}
const { title, subtitle, image } = Astro.props;
---

<div class="relative overflow-hidden bg-brand-900">
  {image && (
    <img
      src={image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      loading="eager"
    />
  )}
  <div class="absolute inset-0 bg-black/10"></div>
  <div class="relative mx-auto max-w-content px-4 py-14 sm:px-6 sm:py-20">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{title}</h2>
    {subtitle && <p class="mt-2 max-w-2xl text-brand-100">{subtitle}</p>}
  </div>
</div>
