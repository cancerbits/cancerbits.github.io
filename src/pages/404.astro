---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <div class="mx-auto flex max-w-content flex-col items-center px-4 py-24 text-center sm:px-6">
    <h1 class="text-6xl font-bold text-brand-600">404</h1>
    <p class="mt-4 text-lg text-ink-700">Sorry, we couldn't find that page.</p>
    <a href="/" class="btn mt-6">Back to homepage</a>
  </div>
</BaseLayout>
