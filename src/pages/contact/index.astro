---
import PageLayout from '../../layouts/PageLayout.astro';
import ContactEmail from '../../components/ContactEmail.astro';
import { site } from '../../data/site';
---

<PageLayout
  title="Contact"
  bannerImage="/images/banner6.png"
  description="How to get in touch with the Developmental Cancer Genomics group and find us at St. Anna CCRI in Vienna."
>
  <p class="text-ink-700">
    Please refer to <a href="/join/">this page</a> for questions about joining the team and current vacancies.
  </p>

  <p class="mt-4 text-ink-700">
    Or just drop me an email <ContactEmail />.
  </p>

  <p class="mt-4 text-ink-700">In case you're interested in a visit, this is our physical location:</p>

  <div class="mt-6 overflow-hidden rounded-xl border border-ink-100 bg-white shadow-sm">
    <img src={site.address.photo} alt="CCRI building" class="h-72 w-full object-cover" loading="lazy" />
    <div class="p-6">
      <address class="not-italic text-ink-700">
        <p>{site.address.institute}</p>
        <p>St. Anna Kinderkrebsforschung, {site.address.street}, {site.address.city}</p>
      </address>
      <p class="mt-3">
        <a href={site.address.mapsUrl} target="_blank" rel="noopener noreferrer">Get directions on Google Maps</a>
      </p>
    </div>
  </div>
</PageLayout>
